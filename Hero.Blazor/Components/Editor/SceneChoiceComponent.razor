@using Hero.Shared.Dtos
@using Hero.Shared.Dtos.Editor
@inject HttpClient Http

<div class="border rounded p-3 mb-3">
    <div class="d-flex flex-column mb-2">
        <label>Texte du choix</label>
        <InputText @bind-Value="Choice.Text"></InputText>
    </div>
    <div class="d-flex flex-column mb-2">
        <label>Type de choix</label>
        <InputSelect class="form-select" @bind-Value="Choice.Type">
            @foreach (var type in choiceTypes)
            {
                <option value="@type">@type</option>
            }
        </InputSelect>
    </div>

    @if (Choice.Type == "Changer de scène")
    {
        <div class="d-flex flex-column mb-2">
            <label>Scène cible</label>
            <InputSelect class="form-select" @bind-Value="Choice.TargetSceneId">
                @foreach (var scene in availableScenes)
                {
                    <option value="@scene.Id">@scene.Name</option>
                }
            </InputSelect>
        </div>
    }

    @if (Choice.Type == "Trésor")
    {
        <div class="d-flex flex-column mb-2">
            <label>Objet</label>
            <InputSelect class="form-select" @bind-Value="Choice.TargetItemId">
                @foreach (var item in availableItems)
                {
                    <option value="@item.Id">@item.Name</option>
                }
            </InputSelect>
        </div>
    }

    <button type="button" class="btn btn-danger mt-2" @onclick="() => RemoveChoice()">Supprimer ce choix</button>
</div>

@code {
    [Parameter] public required SceneChoiceDto Choice { get; set; }
    [Parameter] public EventCallback OnRemoveChoice { get; set; }

    private List<string> choiceTypes = new() { "Changer de scène", "Trésor" };
    private string choiceText = string.Empty;
    private List<SceneDto> availableScenes=[];
    private List<ItemDto> availableItems=[];

    protected override async Task OnInitializedAsync()
    {
        availableScenes = await Http.GetFromJsonAsync<List<SceneDto>>("api/scenes") ?? new();
        availableItems = await Http.GetFromJsonAsync<List<ItemDto>>("api/items") ?? new();
    }

    private async Task RemoveChoice()
    {
        await OnRemoveChoice.InvokeAsync();
    }
}
