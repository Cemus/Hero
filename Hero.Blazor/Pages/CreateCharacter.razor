@using Hero.Blazor.FormModels
@using Hero.Shared.Dtos
@using Microsoft.AspNetCore.Components.Forms
@using System.ComponentModel.DataAnnotations
@inject NavigationManager NavigationManager
@inject HttpClient Http
@page "/create-character"

<PageTitle>Créer un personnage</PageTitle>

<h1>Nouveau personnage</h1>

<EditForm Model="@characterModel" OnValidSubmit="@HandleValidSubmit">
    <DataAnnotationsValidator />
    <ValidationSummary />

    @if (!string.IsNullOrEmpty(error))
    {
        <p class=" alert-danger">@error</p>

    }
    <fieldset>
        <legend>Choisissez un nom</legend>
        <div>
            <label for="name">Nom du personnage</label>
            <InputText id="name" @bind-Value="characterModel.Name" maxlength="10" />
        </div>
    </fieldset>

    <fieldset>
        <legend>Choisissez une classe</legend>
        <label>Classe :</label>
        <InputRadioGroup  @bind-Value="characterModel.Job" >
            @foreach (var job in jobs)
            {
                <div>
                    <InputRadio TValue="string"  Value="@job" />
                    <label>@job</label>
                </div>
            }
        </InputRadioGroup>
    </fieldset>

    <button type="submit">Créer @(characterModel.Name != "" ? characterModel.Name : "votre perso")</button>
</EditForm>

@code {
    private CharacterFormModel characterModel = new();
    private string error = string.Empty;

    private List<string> jobs = new() { "warrior", "scholar", "thief" };

    private async Task HandleValidSubmit()
    {
        var player = new CreatePlayerDto
        {
            Name = characterModel.Name,
            JobName = characterModel.Job ?? "???",
        };

        var response = await Http.PostAsJsonAsync("api/players", player);

        if (response.IsSuccessStatusCode)
        {
            error = string.Empty;
            NavigationManager.NavigateTo("characters");
        }
        else
        {
            error = "Le nom du personnage doit faire au minimum 3 caractères et au maximum 12 caractères.";
        }
    }
}
