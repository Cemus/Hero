@page "/scene-editor"
@using System.ComponentModel.DataAnnotations
@using Hero.Blazor.FormModels

<PageTitle>Editeur de scène</PageTitle>

<h1>Les scenes</h1>

<EditForm Model="@sceneFormModel">
	<div class="d-flex flex-column">
		<label id="sceneName">Nom de la scène</label>
		<InputText id="sceneName" @bind-Value="@sceneName"></InputText>
	</div>
	<div class="d-flex flex-column">
		<label id="sceneDescription">Description de la scène</label>
		<InputTextArea id="sceneDescription" @bind-Value="@sceneDescription"></InputTextArea>
	</div>

	<div class="d-flex flex-column">
		<label id="choices">Choix</label>
		<InputSelect id="choices" @bind-Value="@sceneChoice">
		@foreach (var choice in sceneChoices)
		{
			<option value="choice">@choice</option>
		}
		</InputSelect>

	</div>

</EditForm>

@code {
	SceneFormModel sceneFormModel = new();
	string sceneName = string.Empty;
	string sceneDescription = string.Empty;
	List<string> sceneChoices = ["Test", "treasure"];
	string sceneChoice = string.Empty;
}
