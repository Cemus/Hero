@using Hero.Shared.Dtos
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject NavigationManager NavigationManager
@inject Services.PlayerStateService PlayerState
@inject ILogger<Scene> Logger
@inject HttpClient Http
@page "/story"

<PageTitle>Histoire</PageTitle>


<h1>@scene?.Name</h1>

<p>@scene?.Description</p>
<p>@outcomeText</p>

<ul>
    @if (scene != null)
    {
        foreach (var choice in scene.Choices)
        {
            <li><button @onclick="()=>HandleChoice(choice.Id)" class="btn bg-dark text-white my-2">@choice.Description</button></li>
        }
    }
</ul>

@code {
    private SceneDto? scene;
    private string outcomeText = string.Empty;

    protected async Task Update()
    {
        try
        {
            var character = PlayerState.CurrentPlayer;

            Logger.LogInformation(JsonSerializer.Serialize(character));

            if (character == null)
            {
                throw new Exception("Personnage non trouvé");
            }

            var updatedCharacter = PlayerState.CurrentPlayer = await Http.GetFromJsonAsync<PlayerDto>($"api/players/{character.Id}");
            scene = await Http.GetFromJsonAsync<SceneDto>($"api/scenes/{updatedCharacter!.SceneId}");
        }
        catch (Exception ex)
        {

            Console.WriteLine($"[ERROR] {ex.Message}");
            NavigationManager.NavigateTo("characters");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Update();
    }

    async Task HandleChoice(int choiceId)
    {
        try
        {
            var player = PlayerState.CurrentPlayer;


            if (player == null)
            {

                throw new Exception("Joueur non trouvé");
            }


            var choice = new ChoiceRequestDto
                {
                    PlayerId = player.Id,
                    ChoiceId = choiceId
                };

            var response = await Http.PostAsJsonAsync("api/choices", choice);

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChoiceResultDto>();

                if (result != null)
                {
                    await Update();
                    outcomeText = result.FeedBack;

                }
            }
            else
            {
                var errorText = await response.Content.ReadAsStringAsync();
                throw new Exception($"Erreur : {response.ReasonPhrase} + {errorText}");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] {ex.Message}");
            NavigationManager.NavigateTo("characters");
        }
      
    }
}
