@using Hero.Shared.Dtos
@using System.Text.Json
@using Microsoft.Extensions.Logging
@inject ILogger<Scene> Logger
@inject HttpClient Http
@page "/story"

<PageTitle>Histoire</PageTitle>


<h1>@scene?.Name</h1>

<p>@scene?.Description</p>
<p>@outcomeText</p>

<ul>
    @if (scene != null)
    {
        foreach (var choice in scene.Choices)
        {
            <li><button @onclick="()=>HandleChoice(choice.Id)" class="btn bg-dark text-white my-2">@choice.Description</button></li>
        }
    }
</ul>

@code {
    private SceneDto? scene;
    private string outcomeText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            scene = await Http.GetFromJsonAsync<SceneDto>("api/scenes/7"); // Hardcodé, à fix
            Console.WriteLine(JsonSerializer.Serialize(scene));
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[ERROR] {ex.Message}");
        }
    }

    async Task HandleChoice(int choiceId)
    {
        var choice = new ChoiceRequestDto
            {
                PlayerId = 16, // Hardcodé à fix !
                ChoiceId = choiceId
            };

        var response = await Http.PostAsJsonAsync("api/choices", choice);

        if (response.IsSuccessStatusCode)
        {
            var result = await response.Content.ReadFromJsonAsync<ChoiceResultDto>();

            if (result != null)
            {
                outcomeText = result.FeedBack;
            }
        }
        else
        {
            Console.WriteLine("Erreur : " + response.ReasonPhrase);
        }

    }
}
