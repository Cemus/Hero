@inject HttpClient Http
@inject Services.PlayerStateService PlayerState
@using Hero.Shared.Dtos
@page "/characters"

<PageTitle>Personnages</PageTitle>

<h1>Personnages</h1>
<p>Base Address: @Http.BaseAddress</p>

@if (players == null)
{
    <p><em>Chargement...</em></p>
}
else
{
    <ul>
        @foreach (var player in players)
        {
            <li>
                <NavLink
                @onclick="()=>UpdatePlayerState(player)" class="nav-btn" href="/story">@player.Name <span>(@player.Job.Name)</span></NavLink>
            </li>
        }
    </ul>
}

@code {
    private List<PlayerDto>? players;

    protected override async Task OnInitializedAsync()
    {
        players = await Http.GetFromJsonAsync<List<PlayerDto>>("api/players");
    }

    protected void UpdatePlayerState(PlayerDto player)
    {
        PlayerState.SetPlayer(player);
    }
}

